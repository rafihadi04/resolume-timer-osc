{
  "name": "resolume-timer-osc",
  "version": "1.0.0",
  "description": "Resolume Arena Application Timer",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "build:win-portable": "npm run build && electron-builder --win portable",
    "build:win-portable:local": "npm run build && electron-builder --win portable --config.win.signAndEditExecutable=false",
    "build:release": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "i18next": "^23.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  }
}
