{
  "appId": "com.resolume.timer",
  "productName": "Resolume Timer",
  "directories": {
    "output": "dist"
  },
  "files": [
    "dist-renderer/**/*",
    "src/main/**/*",
    "assets/**/*",
    "node_modules/@stagetimerio/grandiose/**/*",
    "package.json"
  ],
  "asarUnpack": [
    "**/@stagetimerio/grandiose/dist/**"
  ],
  "win": {
    "target": ["portable"]
  },
  "mac": {
    "target": ["dmg", "zip"]
  }
}
